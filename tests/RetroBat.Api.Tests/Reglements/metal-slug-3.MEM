  events = {
    flow = {
      lifecycle = {
        { address=0X10040C, type="u8", condition="eq", value=0X07, action="DEMO_MODE", desc="Mission 07 = Demo" },
        -- Le BIOS met PLAYER_MOD1 a 1 quand le joueur 1 part (depart, continue, partie relancee),
        -- jamais pendant la demo : la partie commence, meme sans START vu (labo, manette reseau).
        { address=0X10FDB6, type="u8", condition="eq", value=0X01, action="GAME_START", desc="P1 status : playing" },
        { address=0X10FDB6, type="u8", condition="eq", value=0X02, action="CONTINUE_SCREEN", desc="P1 status : continue" },
        { address=0X10FDB6, type="u8", condition="eq", value=0X03, action="GAME_OVER", desc="P1 status : game over" },
      },
      settings = {
        { address=0X10FD88, type="u8", condition="change", action="SETTINGS_CHANGED", desc="Soft Dip - lives (01=1, 03=3 default, 63=99)" },
        { address=0X10FD8B, type="u8", condition="change", action="SETTINGS_CHANGED", desc="Soft Dip - difficulty (03=4 default)" },
        { address=0X10FD8A, type="u8", condition="change", action="SETTINGS_CHANGED", desc="Soft Dip - toggle continue" },
      },
    },
    progression = {
      stage = {
        { address=0X10040C, type="u8", condition="change", action="PROGRESSION_STAGE", desc="Mission (0 = mission 1, 3 = mission 4, 8 = transition entre deux missions)" },
        { address=0X10040D, type="u8", condition="change", action="PROGRESSION_STAGE", desc="Section on stage" },
        { address=0X100475, type="u8", condition="change", action="PROGRESSION_STAGE", desc="Horizontal stage progress" },
        { address=0X10ED05, type="u8", condition="change", action="PROGRESSION_STAGE", desc="P1 saved hostages" },
      },
    },
    resources = {
      -- L'etat de chaque joueur, tenu par le BIOS Neo-Geo (vaut pour tout jeu Neo-Geo) :
      -- BIOS_PLAYER_MOD1/2, 0 titre, 1 en jeu, 2 ecran de continue, 3 game over. Les credits du
      -- BIOS (0xD00034) sont hors de la RAM que FBNeo expose : le continue se lit ici. Une baisse
      -- est le continue de CE joueur (2 -> 1), la premiere lecture du joueur 2 son arrivee (0 -> 1).
      -- min/max bornent l'ecart entre deux lectures : le test RAM du demarrage (55, AA, FD) et le
      -- retour au titre (3 -> 0) se taisent, une partie relancee (3 -> 1) reste un continue.
      -- Verifie sous MAME le 2026-10-02 (sonde : 1 a 2402, 2 a 6897, 3 a 8177, 0 a 8924, 1 a 9003).
      continues = {
        { address=0X10FDB6, type="u8", condition="change", min=1, max=2, action="CONTINUES", player=1, desc="P1 status (BIOS_PLAYER_MOD1)" },
        { address=0X10FDB7, type="u8", condition="change", min=1, max=2, action="CONTINUES", player=2, desc="P2 status (BIOS_PLAYER_MOD2)" },
      },
      lives = {
