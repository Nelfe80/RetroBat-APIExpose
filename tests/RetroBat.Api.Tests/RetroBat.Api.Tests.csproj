<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <!-- Le Data Pack voisin du depot (E:\RetroBat\plugins\RetroBat-DataPack) ; NELFEPLAY_DATAPACK le deplace
         (worktree, integration continue). -->
    <DataPackDir Condition="'$(NELFEPLAY_DATAPACK)' != ''">$(NELFEPLAY_DATAPACK)</DataPackDir>
    <DataPackDir Condition="'$(DataPackDir)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\..\..\RetroBat-DataPack'))</DataPackDir>
  </PropertyGroup>

  <Target Name="VerifierDataPackReglements" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(DataPackDir)\challenges\rulesets')"
           Text="Reglements de challenges introuvables : $(DataPackDir)\challenges\rulesets. Cloner RetroBat-DataPack a cote du depot ou fixer NELFEPLAY_DATAPACK." />
  </Target>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RetroBat.Api\RetroBat.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Vecteur produit par l'implementation PHP de la plateforme (R9). Il est la pour prouver
         que les deux langages canonicalisent PAREIL : si la signature ne verifie plus ici, c'est
         que les deux cotes ont divergé, et aucune borne ne pourrait plus croire un evenement. -->
    <None Update="social-events-vector.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="social-summary-vector.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Les reglements de challenges (nelfe.challenge.v2) tels qu'ils sont deposes sur le site : les tests partent
         d'eux. Leurs sources sont au Data Pack (challenges/rulesets), copiees sous Reglements\ a la sortie. -->
    <!-- Les ROMs admises (11/11) : un extrait reel du referentiel, des .MEM et de l'index des jeux ouverts. -->
    <None Include="RomsAdmises\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="$(DataPackDir)\challenges\rulesets\*.json" Link="Reglements\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Le .MEM que cite un reglement de test : VerifierContre le relit tel quel. -->
    <None Update="Reglements\*.MEM">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Les parties jouees au banc fceumm (Super Mario Bros., 03/11), au format des traces du banc des replays. -->
    <None Update="Reglements\*.trace">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Le .SMEM de 19XX et les deux .MEM qu'il peut accompagner (couche de test du 08/11, officiel) : copies. -->
    <None Update="Smem\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
