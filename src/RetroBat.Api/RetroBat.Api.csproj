<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="$(MSBuildProjectDirectory)\artifacts\**\*" />
    <Content Remove="$(MSBuildProjectDirectory)\..\..\artifacts\**\*" />
    <None Remove="$(MSBuildProjectDirectory)\artifacts\**\*" />
    <None Remove="$(MSBuildProjectDirectory)\..\..\artifacts\**\*" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.5.0" />
    <!-- QR 100 % managé (PngByteQRCode) : le code de réclamation encodé en QR
         sur l'overlay de fin de partie, sans dépendance native ni réseau. -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RetroBat.Domain\RetroBat.Domain.csproj" />
    <ProjectReference Include="..\RetroBat.Providers.EmulationStation\RetroBat.Providers.EmulationStation.csproj" />
    <ProjectReference Include="..\RetroBat.Providers.MameOutputs\RetroBat.Providers.MameOutputs.csproj" />
    <ProjectReference Include="..\RetroBat.MediaStore\RetroBat.MediaStore.csproj" />
    <ProjectReference Include="..\RetroBat.Providers.Hi2Txt\RetroBat.Providers.Hi2Txt.csproj" />
    <ProjectReference Include="..\RetroBat.Providers.RetroArchWrapper\RetroBat.Providers.RetroArchWrapper.csproj" />
  </ItemGroup>

  <!-- Les images dont le code a besoin voyagent dans l'exe. Le dossier media n'est livre ni par la
       mise a jour ni par l'installeur : lues la-bas, elles manquaient a toutes les bornes sauf celle
       qui fabrique la release (legende des reactions absente, icones du concours en direct omises). -->
  <ItemGroup>
    <None Remove="Replay\Overlay\reacts-icons.png;Infrastructure\livecontest-icon.png;Infrastructure\livecontest-icon-big.png" />
    <EmbeddedResource Include="Replay\Overlay\reacts-icons.png" LogicalName="RetroBat.Api.reacts-icons.png" />
    <EmbeddedResource Include="Infrastructure\livecontest-icon.png" LogicalName="RetroBat.Api.livecontest-icon.png" />
    <EmbeddedResource Include="Infrastructure\livecontest-icon-big.png" LogicalName="RetroBat.Api.livecontest-icon-big.png" />
  </ItemGroup>

  <!-- Media discovery internals (BuildAssetTable, MediaStreamAsset) are exercised by
       golden/parity tests that guard the Hotpath refactor; nothing behavioural changes. -->
  <ItemGroup>
    <InternalsVisibleTo Include="RetroBat.Api.Tests" />
  </ItemGroup>
</Project>
